            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comedor\",\n  \"type\": \"THERMOSTAT\",\n  \"location\": \"Comedor principal\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/{{deviceId}}",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "{{deviceId}}"]
            },
            "description": "Replaces (PUT) all the data of the device. Responses: 200 / 400 / 404."
          }
        },
        {
          "name": "Delete device",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/{{deviceId}}",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "{{deviceId}}"]
            },
            "description": "Deletes the specified device. Responses: 204 / 404."
          }
        },
        {
          "name": "List devices by user id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/user/{{userId}}?page=0&size=10",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "user", "{{userId}}"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
