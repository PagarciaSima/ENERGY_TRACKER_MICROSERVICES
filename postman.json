{
  "info": {
    "name": "ENERGY_TRACKER - User, Device & Ingestion Services",
    "description": "Collection to test the user (port 8080), device (port 8081) and ingestion (port 8082) microservices of the Home Energy Tracker platform. Ids in the paths use variables so they can be reused.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "userBaseUrl", "value": "http://localhost:8080" },
    { "key": "deviceBaseUrl", "value": "http://localhost:8081" },
    { "key": "ingestionBaseUrl", "value": "http://localhost:8082" },
    { "key": "userId", "value": "1" },
    { "key": "deviceId", "value": "1" }
  ],
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"surname\": \"García\",\n  \"email\": \"ana.garcia@example.com\",\n  \"address\": \"Calle Mayor 5, Madrid\",\n  \"alerting\": true,\n  \"energyAlertingThreshold\": 3200.5\n}"
            },
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user"]
            },
            "description": "Creates a user (auto-generated id). Responses: 201 / 400 (validation) / 409 (duplicate email)."
          }
        },
        {
          "name": "List all users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user"]
            },
            "description": "Returns all users without pagination. Response: 200 (UserDto array)."
          }
        },
        {
          "name": "List users (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user/page?page=0&size=10",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user", "page"],
              "query": [
                { "key": "page", "value": "0", "description": "Page index (0-based). Min 0." },
                { "key": "size", "value": "10", "description": "Page size. Between 1 and 100." }
              ]
            },
            "description": "Returns a page of users wrapped in a PageResponse."
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user/search?name=An&surname=Garc&email=&address=Madrid&alerting=true&minEnergyAlertingThreshold=2500&page=0&size=10",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user", "search"],
              "query": [
                { "key": "name", "value": "An", "description": "Name fragment (optional)" },
                { "key": "surname", "value": "Garc", "description": "Surname fragment (optional)" },
                { "key": "email", "value": "", "description": "Email fragment (optional)" },
                { "key": "address", "value": "Madrid", "description": "Address fragment (optional)" },
                { "key": "alerting", "value": "true", "description": "Alerting boolean (optional)" },
                { "key": "minEnergyAlertingThreshold", "value": "2500", "description": "Minimum threshold (optional)" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Searches users applying optional filters. Response: PageResponse."
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user/{{userId}}",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user", "{{userId}}"]
            },
            "description": "Returns the user by id. Responses: 200 / 404."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana María\",\n  \"surname\": \"García López\",\n  \"email\": \"ana.garcia@example.com\",\n  \"address\": \"Avda. del Sol 12, Madrid\",\n  \"alerting\": true,\n  \"energyAlertingThreshold\": 2800.0\n}"
            },
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user/{{userId}}",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user", "{{userId}}"]
            },
            "description": "Replaces (PUT) all the data of the specified user. Responses: 200 / 400 / 404."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/user/{{userId}}",
              "host": ["{{userBaseUrl}}"],
              "path": ["api", "v1", "user", "{{userId}}"]
            },
            "description": "Deletes the specified user. Responses: 204 (No Content) / 404."
          }
        }
      ]
    },
    {
      "name": "Device Service",
      "item": [
        {
          "name": "Create device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salón\",\n  \"type\": \"LIGHT\",\n  \"location\": \"Salón principal\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device"]
            },
            "description": "Creates a device linked to a userId (auto-generated id). Valid types: SPEAKER, CAMERA, THERMOSTAT, LIGHT, LOCK, DOORBELL. Responses: 201 / 400."
          }
        },
        {
          "name": "List devices (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device?page=0&size=10",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Returns a page of all devices. Response: PageResponse."
          }
        },
        {
          "name": "Search devices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/search?name=Sal&type=LIGHT&location=Madrid&userId=1&page=0&size=10",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "search"],
              "query": [
                { "key": "name", "value": "Sal", "description": "Name fragment (optional)" },
                { "key": "type", "value": "LIGHT", "description": "Exact type: SPEAKER/CAMERA/THERMOSTAT/LIGHT/LOCK/DOORBELL" },
                { "key": "location", "value": "Madrid", "description": "Location fragment (optional)" },
                { "key": "userId", "value": "1", "description": "Owner user id (optional)" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Searches devices applying optional filters. Response: PageResponse."
          }
        },
        {
          "name": "Get device by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/{{deviceId}}",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "{{deviceId}}"]
            },
            "description": "Returns the device by id. Responses: 200 / 404."
          }
        },
        {
          "name": "Update device",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comedor\",\n  \"type\": \"THERMOSTAT\",\n  \"location\": \"Comedor principal\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/{{deviceId}}",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "{{deviceId}}"]
            },
            "description": "Replaces (PUT) all the data of the device. Responses: 200 / 400 / 404."
          }
        },
        {
          "name": "Delete device",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/{{deviceId}}",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "{{deviceId}}"]
            },
            "description": "Deletes the specified device. Responses: 204 / 404."
          }
        },
        {
          "name": "List devices by user id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{deviceBaseUrl}}/api/v1/device/user/{{userId}}?page=0&size=10",
              "host": ["{{deviceBaseUrl}}"],
              "path": ["api", "v1", "device", "user", "{{userId}}"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Returns a page of the devices belonging to the specified user. Response: PageResponse."
          }
        }
      ]
    },
    {
      "name": "Ingestion Service",
      "item": [
        {
          "name": "Ingest energy usage",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": 42,\n  \"energyConsumed\": 3.5,\n  \"timestamp\": \"2026-10-04T15:30:45Z\"\n}"
            },
            "url": {
              "raw": "{{ingestionBaseUrl}}/api/v1/ingestion",
              "host": ["{{ingestionBaseUrl}}"],
              "path": ["api", "v1", "ingestion"]
            },
            "description": "Publishes a single energy usage reading from an IoT device. The reading is validated, enriched with a timestamp if missing, and queued in Kafka for downstream processing. Responses: 201 (accepted) / 400 (validation) / 500 (internal error)."
          }
        }
      ]
    }
  ]
}