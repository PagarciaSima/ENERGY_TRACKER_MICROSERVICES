# ============================================================
#  Environment file for the FULL Docker stack
# ============================================================
# Usage (one command builds the images and starts everything):
#     docker compose --env-file .env.docker up -d --build
#     docker compose --env-file .env.docker down          # keeps the volumes
#     docker compose --env-file .env.docker down -v       # also drops the data
#
# Without this file, `docker compose up -d` starts ONLY the infrastructure
# (the seven microservices are behind the `app` profile).

# Enables the `app` profile so the microservices are started too. If your Compose
# version ignores it, add `--profile app` to the command.
COMPOSE_PROFILES=app

# Prometheus scrape configuration: container names instead of host.docker.internal.
PROMETHEUS_CONFIG_FILE=prometheus.docker.yml

# Skip the unit tests while building the images (they run with `.\mvnw.cmd test`).
SKIP_TESTS=true
